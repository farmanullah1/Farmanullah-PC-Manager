<UserControl x:Class="PCManager.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCManager.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,12,14">
        <Grid MaxWidth="{StaticResource App.ContentMaxWidth}" HorizontalAlignment="Stretch">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" Orientation="Horizontal">
                    <controls:Icon3D Key="Apps" Size="44" Margin="{StaticResource Thickness.3}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Apps" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="Running applications, what starts with Windows, and everything installed on this PC." />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon3D Key="Restore" Size="14" Margin="{StaticResource Thickness.1}" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Process management -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon3D Key="ProcessList" Size="24" Margin="{StaticResource Thickness.1}" />
                            <TextBlock Text="Process management" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ProcessSummary}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,12,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ProcessSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search running applications"
                                 AutomationProperties.Name="Search running applications" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ProcessSortOptions}"
                                  SelectedItem="{Binding ProcessSort, Mode=TwoWay}"
                                  Margin="{StaticResource Thickness.2}"
                                  AutomationProperties.Name="Sort running applications" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding VisibleRunningApps}"
                                  Style="{StaticResource CardList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsVirtualizing="True"
                                                        VirtualizationMode="Recycling" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PidText}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="12,0" MinWidth="52" />
                                        <TextBlock Grid.Column="2" Text="{Binding MemoryText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" MinWidth="80" />
                                        <Button Grid.Column="3" Content="End" Style="{StaticResource PillButton}"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding EndCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Startup apps -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon3D Key="Startup" Size="24" Margin="{StaticResource Thickness.1}" />
                            <TextBlock Text="Startup apps" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Reload" Style="{StaticResource PillButton}"
                                HorizontalAlignment="Right" Command="{Binding RefreshStartupCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="Read from HKCU/HKLM Run, the Startup folders and Task Scheduler." />

                    <ItemsControl ItemsSource="{Binding StartupApps}" Margin="0,12,0,0"
                                  Style="{StaticResource CardList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Command}" Style="{StaticResource CaptionText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="12,0" />
                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- App management -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="DeepUninstall" Size="24" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="App management" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding InstalledSummary}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <TextBox Text="{Binding AppSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search installed apps" Margin="{StaticResource Thickness.1}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding InstalledApps}" Style="{StaticResource CardList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" Margin="12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                                   VerticalAlignment="Center" MinWidth="70" />
                                        <Button Grid.Column="3" Content="Leftovers" Style="{StaticResource PillButton}"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                ToolTip="Scan for orphaned leftovers of this application"
                                                Command="{Binding ScanLeftoversCommand}" />
                                        <Button Grid.Column="4" Content="Uninstall" Style="{StaticResource PillButton}"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding UninstallCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Store/MSIX apps -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Store" Size="24" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Microsoft Store apps" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding StoreAppsSummary}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               Text="MSIX packages for this account. Framework, resource and system packages are hidden; Microsoft PC Manager is never removed by this app." />

                    <ItemsControl ItemsSource="{Binding StoreApps}" Style="{StaticResource CardList}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6"
                                        ToolTip="{Binding PackageFullName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Uninstall" Style="{StaticResource PillButton}"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding UninstallCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Deep Uninstall & Leftovers Discovery -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon3D Key="DeepUninstall" Size="24" Margin="{StaticResource Thickness.1}" />
                        <TextBlock Text="Deep Uninstall &amp; Leftovers" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,10"
                               Text="Scan for orphaned data folders and registry keys left behind by uninstalled applications. Folders are sent to the Recycle Bin and registry keys are backed up before removal." />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding LeftoverTargetApp, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Application name to scan for remnants" />
                        <Button Grid.Column="1" Content="Scan Leftovers" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding ScanLeftoversCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding LeftoverSummary}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding LeftoverItems}" MaxHeight="240" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsSafeToRemove}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Border Background="{DynamicResource App.CardBackground}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding KindText}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TargetPath}" Style="{StaticResource CaptionText}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetPath}" />
                                            <TextBlock Text="{Binding SafetyReason}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="12,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding IsSafeToRemove, StringFormat='Safe: {0}'}"
                                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding HasLeftoverItems, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                        <WrapPanel>
                            <Button Content="Clean Selected Leftovers" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CleanLeftoversCommand}" Margin="0,0,8,4" />
                            <Button Content="Export .reg Backup" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ExportRegBackupCommand}" Margin="0,0,8,4" />
                        </WrapPanel>
                        <TextBlock Text="Folders are sent to the Windows Recycle Bin (recoverable). Registry entries are backed up to %LOCALAPPDATA%\FPM\Backups\."
                                   Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />

        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
