<UserControl x:Class="PCManager.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCManager.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,14,16">
        <Grid MaxWidth="{StaticResource App.ContentMaxWidth}" HorizontalAlignment="Stretch">
        <StackPanel>
            <!-- Page Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                    <controls:Icon3D Key="Memory" Size="44" Margin="{StaticResource Thickness.3}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Memory Care" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="Real diagnostics, memory pressure metrics, and non-destructive per-application relief." />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon3D Key="Restore" Size="14" Margin="{StaticResource Thickness.1}" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Memory Metrics Overview Card -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="System Memory" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="MemoryTotalText" Text="{Binding TotalPhysicalText}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- RAM Usage Progress Bar -->
                    <ProgressBar x:Name="MemoryLoadProgress" Style="{StaticResource ThinProgress}" Height="8" Margin="0,6,0,8"
                                 Value="{Binding LoadPercent, Mode=OneWay}" />

                    <Grid Margin="0,0,0,10">
                        <TextBlock x:Name="MemoryAvailableText" Text="{Binding AvailablePhysicalText}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding CommitChargeText}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource App.Border}" Margin="0,4,0,10" />

                    <!-- Pressure Indicator -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Pressure Level: " Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" />
                            <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource App.Hover}"
                                    BorderBrush="{DynamicResource App.Accent}" BorderThickness="1"
                                    Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PressureText}" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{DynamicResource App.AccentBar}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding PressureDescription}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Measured Relief Report Banner -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource App.Hover}"
                    BorderBrush="{DynamicResource App.Accent}" BorderThickness="1"
                    Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding HasReliefReport, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:Icon3D Key="MemoryRelief" Size="22" Tint="Success"
                                     VerticalAlignment="Center" Margin="0,0,10,0" Animated="True" />
                    <TextBlock Grid.Column="1" Text="{Binding ReliefReportText}" FontWeight="SemiBold"
                               FontSize="12" Foreground="{DynamicResource App.Text}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Running Applications & Process Relief Card -->
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon3D Key="MemoryRelief" Size="28" Margin="{StaticResource Thickness.2}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Applications &amp; Memory Relief" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Select user applications to close gracefully. Saves unsaved work first."
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel Margin="{StaticResource Thickness.1}">
                            <Button Content="Select Safe" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,6,0" Command="{Binding SelectAllSafeCommand}"
                                    Padding="10,4" FontSize="11" />
                            <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0" Command="{Binding DeselectAllCommand}"
                                    Padding="10,4" FontSize="11" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RelieveSelectedCommand}"
                                    Padding="12,5" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon3D Key="Close" Size="12" Tint="Neutral" Margin="{StaticResource Thickness.1}" />
                                    <TextBlock Text="Close Selected" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Process List -->
                    <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="6"
                            MaxHeight="360" Background="{DynamicResource App.Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="MemoryProcessList" ItemsSource="{Binding Processes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsVirtualizing="True"
                                                                VirtualizationMode="Recycling" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                                                Padding="10,7" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Selection Checkbox -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanRelieve}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Left" />

                                                <!-- Process Name -->
                                                <TextBlock Grid.Column="1" Text="{Binding ProcessName}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <!-- PID -->
                                                <TextBlock Grid.Column="2" Text="{Binding Id, StringFormat='PID {0}'}"
                                                           Style="{StaticResource CaptionText}" FontSize="10"
                                                           VerticalAlignment="Center" />

                                                <!-- Working Set -->
                                                <TextBlock Grid.Column="3" Text="{Binding FormattedWorkingSet}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           ToolTip="Working set (physical RAM used)" />

                                                <!-- Private Bytes -->
                                                <TextBlock Grid.Column="4" Text="{Binding FormattedPrivateBytes}"
                                                           Style="{StaticResource CaptionText}" FontSize="10"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           ToolTip="Private committed bytes" Margin="0,0,10,0" />

                                                <!-- Status Badge -->
                                                <Border Grid.Column="5" CornerRadius="3" Padding="4,1"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock FontSize="9"
                                                               Text="{Binding CanRelieve, Converter={x:Null}}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="System and security processes are protected and cannot be closed."
                               Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
