<UserControl x:Class="PCManager.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCManager.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource Page.MarginCompact}">
        <Grid MaxWidth="{StaticResource App.ContentMaxWidth}" HorizontalAlignment="Stretch">
            <StackPanel>

                <Grid Margin="{StaticResource Card.Margin}">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon3D Key="Debloat" Size="44" Margin="{StaticResource Thickness.3}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Windows Debloat" Style="{StaticResource PageTitle}"
                                       AutomationProperties.Name="Windows Debloat" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                                <Run Text="{Binding OsText, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding CatalogStatus, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource Card.Margin}">
                    <Button Content="Windows" Style="{StaticResource PillButton}" Margin="{StaticResource Thickness.1}"
                            Command="{Binding ShowWindowsCommand}" AutomationProperties.Name="Windows tab" />
                    <Button Content="Apps" Style="{StaticResource PillButton}" Margin="{StaticResource Thickness.1}"
                            Command="{Binding ShowAppsCommand}" AutomationProperties.Name="Apps tab" />
                    <Button Content="Android" Style="{StaticResource PillButton}" Margin="{StaticResource Thickness.1}"
                            Command="{Binding ShowAndroidCommand}" AutomationProperties.Name="Android tab" />
                </StackPanel>

                <!-- Windows tab -->
                <StackPanel Visibility="{Binding IsWindowsTab, Converter={StaticResource BoolToVisibility}}">
                    <!-- D4: typed user target, preset files and report-only drift. -->
                    <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.4}">
                        <StackPanel>
                            <TextBlock Text="User target" FontSize="17" FontWeight="SemiBold"
                                       AutomationProperties.Name="User target" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Text="Apply to this account, an offline profile hive, or the Default user hive. The helper loads only a typed profile target and always unloads it." />
                            <Grid Margin="{StaticResource Thickness.2}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Targets}"
                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.Name="Debloat user target" />
                                <Button Grid.Column="1" Content="Refresh profiles" Style="{StaticResource PillButton}"
                                        Margin="{StaticResource Thickness.2}"
                                        Command="{Binding RefreshTargetsCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding TargetWarning}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource App.Warning.Text}" />

                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.2}">
                                <Button Content="Export preset" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ExportPresetCommand}" Margin="{StaticResource Thickness.1}"
                                        AutomationProperties.Name="Export debloat preset" />
                                <Button Content="Import preset" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ImportPresetCommand}" Margin="{StaticResource Thickness.1}"
                                        AutomationProperties.Name="Import debloat preset" />
                                <Button Content="Check drift" Style="{StaticResource PillButton}"
                                        Command="{Binding DriftCheckCommand}" Margin="{StaticResource Thickness.1}"
                                        AutomationProperties.Name="Check debloat drift" />
                            </StackPanel>
                            <TextBlock Text="{Binding PresetFileText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DriftText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       AutomationProperties.Name="Debloat drift result" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.4}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Preset and restore point" FontSize="17" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                              DisplayMemberPath="Name" Margin="{StaticResource Thickness.2}"
                                              MinWidth="220" HorizontalAlignment="Left"
                                              AutomationProperties.Name="Debloat preset" />
                                    <TextBlock Text="{Binding SelectedPreset.Description}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" MaxWidth="420" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          Content="Create restore point first" VerticalAlignment="Top"
                                          IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}"
                                          ToolTip="Attempted before non-Low-risk runs; a disabled or unavailable System Restore is recorded as skipped." />
                            </Grid>

                            <Grid Margin="{StaticResource Thickness.3}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0"
                                        Padding="{StaticResource Thickness.2}" Margin="{StaticResource Thickness.2}">
                                    <StackPanel>
                                        <TextBlock Text="Categories" Style="{StaticResource SectionTitle}" />
                                        <ListBox ItemsSource="{Binding Categories}"
                                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 MaxHeight="340"
                                                 AutomationProperties.Name="Debloat categories">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="{StaticResource Thickness.1}">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CountText}" Style="{StaticResource CaptionText}"
                                                                   HorizontalAlignment="Right" Margin="{StaticResource Thickness.1}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search tweaks" Margin="{StaticResource Row.Margin}"
                                             AutomationProperties.Name="Search tweaks" />
                                    <ListBox ItemsSource="{Binding Tweaks}" MaxHeight="340"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Debloat tweaks">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RowCard}" Padding="{StaticResource Thickness.2}" Margin="{StaticResource Row.Margin}"
                                                        AutomationProperties.Name="{Binding AutomationName}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding IsSelectable}"
                                                                  VerticalAlignment="Center" Margin="{StaticResource Thickness.2}"
                                                                  AutomationProperties.Name="{Binding AutomationName}" />
                                                        <controls:Icon3D Grid.Column="1" Key="{Binding IconKey}" Size="20"
                                                                         Margin="{StaticResource Thickness.2}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Grid.Column="3" Style="{StaticResource Chip}" Padding="{StaticResource Thickness.1}"
                                                                Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}"
                                                                VerticalAlignment="Center" Margin="{StaticResource Thickness.2}">
                                                            <TextBlock Text="Applied" FontSize="10" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding PlanSummary}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="{StaticResource Thickness.2}" />
                            <TextBlock Text="Selection is turned into an ordered, OS-gated plan. Unsupported or protected tweaks are refused before elevation."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.2}">
                                <Button Content="Select all visible" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelectAllVisibleCommand}" Margin="{StaticResource Thickness.1}" />
                                <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ClearSelectionCommand}" Margin="{StaticResource Thickness.1}" />
                                <Button Content="Review changes" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ReviewCommand}" Margin="{StaticResource Thickness.1}"
                                        AutomationProperties.Name="Review debloat changes" />
                                <Button Content="Detect selected" Style="{StaticResource PillButton}" Margin="{StaticResource Thickness.1}"
                                        Command="{Binding DetectCommand}"
                                        AutomationProperties.Name="Detect selected tweaks" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Running -->
                    <Border x:Name="DebloatRunningCard" Style="{StaticResource Card}" Padding="{StaticResource Thickness.4}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D x:Name="DebloatRunningIcon" Key="Scan" Size="20"
                                                 Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Working…" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding RunningText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True"
                                         Margin="{StaticResource Thickness.2}" />
                            <TextBlock Text="Windows shows an administrator prompt for the helper. FPM explains it here before it appears; declining changes nothing."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Review -->
                    <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.4}"
                            Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Review changes" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       Text="Typed changes only. Current values are captured by the helper immediately before each write and saved to the .reg backup and journal." />
                            <ItemsControl ItemsSource="{Binding PlanRows}" Margin="{StaticResource Thickness.2}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{StaticResource Thickness.1}">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding RiskText}" Style="{StaticResource CaptionText}"
                                                           Margin="{StaticResource Thickness.2}" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ReviewItems}" MaxHeight="220">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" Margin="{StaticResource Thickness.1}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.2}">
                                <Button Content="Apply selected" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ApplyCommand}"
                                        AutomationProperties.Name="Apply selected tweaks" />
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="{StaticResource Thickness.2}"
                                        Command="{Binding CloseReviewCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Report: success, failure, partial rollback, permission declined -->
                    <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.4}"
                            Visibility="{Binding IsReportVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Restore" Size="20" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="{Binding ReportHeadline}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="{StaticResource Thickness.2}"
                                    Visibility="{Binding ReportRolledBack, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Partially rolled back" FontSize="10" />
                            </Border>
                            <TextBlock Text="{Binding ReportDetail}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="{StaticResource Thickness.1}" />
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.2}">
                                <Button Content="Undo this run" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding UndoCommand}"
                                        AutomationProperties.Name="Undo debloat run" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Error -->
                    <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.4}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Something went wrong" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- History -->
                    <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.4}">
                        <StackPanel>
                            <TextBlock Text="History" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding HistoryText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding HistoryRows}" Margin="{StaticResource Thickness.1}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.2}">
                                <Button Content="Undo last run" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding UndoCommand}" />
                                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="{StaticResource Thickness.2}"
                                           Text="Every run is journaled under %LOCALAPPDATA%\FPM\debloat." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Apps tab -->
                <StackPanel Visibility="{Binding IsAppsTab, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.4}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Apps" Size="24" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Preinstalled apps" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding AppsSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="{StaticResource Thickness.1}"
                                       Text="Removal is not enabled on this tab: the engine refuses Appx changes until it can capture and journal each package's state. Selected apps are saved in preset files only; nothing is queued for removal." />

                            <Grid Margin="{StaticResource Thickness.2}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding AppSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search app catalog" AutomationProperties.Name="Search debloat apps" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AppFilters}"
                                          SelectedItem="{Binding SelectedAppFilter, Mode=TwoWay}"
                                          Margin="{StaticResource Thickness.2}" MinWidth="140"
                                          AutomationProperties.Name="Debloat app filter" />
                            </Grid>

                            <ListBox ItemsSource="{Binding Apps}" MaxHeight="380" Margin="{StaticResource Thickness.2}"
                                     Background="Transparent" BorderThickness="0"
                                     AutomationProperties.Name="Debloat app catalog">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowCard}" Padding="{StaticResource Thickness.2}" Margin="{StaticResource Row.Margin}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="{StaticResource Thickness.2}"
                                                              AutomationProperties.Name="{Binding Title}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding PackagesText}" Style="{StaticResource CaptionText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="{StaticResource Thickness.2}" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Recommendation}" Style="{StaticResource CaptionText}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding RemovalText}" Style="{StaticResource CaptionText}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Android tab: A1 onboarding, device identity and read-only status. -->
                <StackPanel Visibility="{Binding IsAndroidTab, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.4}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Adb" Size="24" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Android device" FontSize="17" FontWeight="SemiBold"
                                           AutomationProperties.Name="Android device" />
                            </StackPanel>

                            <TextBlock Text="{Binding Android.AdbStatusText}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="{StaticResource Thickness.2}" />
                            <TextBlock Text="{Binding Android.AdbPathText}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Android.DeviceCountText}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.2}">
                                <Button Content="Refresh ADB" Style="{StaticResource PillButton}"
                                        Command="{Binding Android.RefreshCommand}" Margin="{StaticResource Thickness.1}"
                                        AutomationProperties.Name="Refresh ADB" />
                                <Button Content="Download platform-tools" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding Android.DownloadCommand}" Margin="{StaticResource Thickness.1}"
                                        AutomationProperties.Name="Download platform-tools" />
                            </StackPanel>

                            <TextBlock Text="ADB path (optional)" Style="{StaticResource SectionTitle}"
                                       Margin="{StaticResource Thickness.2}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Android.AdbPathOverride, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="A full path to adb.exe, or the folder containing it"
                                         AutomationProperties.Name="ADB path override" />
                                <Button Grid.Column="1" Content="Use this path" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Android.UsePathCommand}" Margin="{StaticResource Thickness.2}"
                                        AutomationProperties.Name="Use ADB path" />
                            </Grid>

                            <TextBlock Text="{Binding Android.OnboardingText}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="{StaticResource Thickness.2}" />

                            <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.3}"
                                    Margin="{StaticResource Thickness.2}">
                                <StackPanel>
                                    <TextBlock Text="Official platform-tools download" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Android.VersionText}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" />
                                    <CheckBox Content="I accept Google's Android SDK License Agreement"
                                              IsChecked="{Binding Android.ConsentGiven, Mode=TwoWay}"
                                              Margin="{StaticResource Thickness.2}"
                                              AutomationProperties.Name="Accept Android SDK license" />
                                    <TextBlock Text="{Binding Android.LicenseText}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Android.LicenseUrl}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.3}"
                                    Margin="{StaticResource Thickness.2}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon3D Key="Apps" Size="24" Margin="{StaticResource Thickness.1}" />
                                        <TextBlock Text="UAD package list" FontWeight="SemiBold"
                                                   AutomationProperties.Name="UAD package list" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Android.PackageList.StatusText}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="{StaticResource Thickness.2}" />
                                    <TextBlock Text="{Binding Android.PackageList.InfoText}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Android.PackageList.DiffText}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" Margin="{StaticResource Thickness.1}" />
                                    <Button Content="Check for list updates" Style="{StaticResource PillButton}"
                                            Command="{Binding Android.PackageList.CheckForUpdatesCommand}"
                                            Margin="{StaticResource Thickness.2}" HorizontalAlignment="Left"
                                            AutomationProperties.Name="Check for list updates" />
                                    <TextBlock Text="{Binding Android.PackageList.ChineseOemNote}"
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.Warning.Text}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Connected devices" Style="{StaticResource SectionTitle}"
                                       Margin="{StaticResource Thickness.2}" />
                            <ComboBox ItemsSource="{Binding Android.Devices}"
                                      SelectedItem="{Binding Android.SelectedDevice, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Android devices" />
                            <TextBlock Text="{Binding Android.DeviceInfoText}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="{StaticResource Thickness.2}"
                                       AutomationProperties.Name="Android device info" />
                            <TextBlock Text="{Binding Android.ProfileText}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Android.UserRows}" Margin="{StaticResource Thickness.1}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.3}"
                                    Margin="{StaticResource Thickness.2}">
                                <StackPanel>
                                    <TextBlock Text="Wireless ADB" FontWeight="SemiBold" />
                                    <TextBlock Text="Private IPv4 addresses only. Pairing code: six digits."
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                    <WrapPanel Margin="{StaticResource Thickness.1}">
                                        <TextBox Text="{Binding Android.WirelessHost, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="180" AutomationProperties.Name="Wireless ADB host"
                                                 Margin="{StaticResource Thickness.1}" />
                                        <TextBox Text="{Binding Android.PairingPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="90" AutomationProperties.Name="Wireless ADB pairing port"
                                                 Margin="{StaticResource Thickness.1}" />
                                        <TextBox Text="{Binding Android.PairingCode, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="90" AutomationProperties.Name="Wireless ADB pairing code"
                                                 Margin="{StaticResource Thickness.1}" />
                                        <TextBox Text="{Binding Android.WirelessPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="90" AutomationProperties.Name="Wireless ADB connect port"
                                                 Margin="{StaticResource Thickness.1}" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.1}">
                                        <Button Content="Pair" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Android.PairWirelessCommand}"
                                                AutomationProperties.Name="Pair wireless ADB"
                                                Margin="{StaticResource Thickness.1}" />
                                        <Button Content="Connect" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding Android.ConnectWirelessCommand}"
                                                AutomationProperties.Name="Connect wireless ADB"
                                                Margin="{StaticResource Thickness.1}" />
                                        <Button Content="Disconnect" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Android.DisconnectWirelessCommand}"
                                                AutomationProperties.Name="Disconnect selected ADB device"
                                                Margin="{StaticResource Thickness.1}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Android.WirelessStatusText}"
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.3}"
                                    Margin="{StaticResource Thickness.2}">
                                <StackPanel>
                                    <TextBlock Text="Device health pre-check" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Android.DeviceHealthText}"
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                               AutomationProperties.Name="Android device health pre-check" />
                                    <TextBlock Text="Battery below 30% shows a warning. The final Apply confirmation remains required."
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.3}"
                                    Margin="{StaticResource Thickness.2}">
                                <StackPanel>
                                    <TextBlock Text="Android package safety" FontWeight="SemiBold" />
                                    <TextBlock Text="Removing system, launcher, telephony or OEM packages can brick or destabilize a phone. Unsafe packages stay blocked unless Expert mode and the exact package id are provided."
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                    <CheckBox Content="I understand the risk"
                                              IsChecked="{Binding Android.PackageManagement.SafetyAcknowledged, Mode=TwoWay}"
                                              AutomationProperties.Name="I understand Android package risk"
                                              Margin="{StaticResource Thickness.2}" />
                                    <TextBlock Text="FAQ: https://github.com/0x192/universal-android-debloater/wiki"
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="{StaticResource Thickness.2}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Android.PackageManagement.Users}"
                                          SelectedItem="{Binding Android.PackageManagement.SelectedUser, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          AutomationProperties.Name="Android user profile"
                                          Margin="{StaticResource Thickness.1}" />
                                <Button Grid.Column="1" Content="Refresh packages"
                                        Style="{StaticResource PillButton}"
                                        Command="{Binding Android.PackageManagement.RefreshCommand}"
                                        AutomationProperties.Name="Refresh Android packages"
                                        Margin="{StaticResource Thickness.1}" />
                            </Grid>

                            <TextBlock Text="{Binding Android.PackageManagement.StatusText}"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="{StaticResource Thickness.1}" />
                            <WrapPanel Margin="{StaticResource Thickness.1}">
                                <TextBox Text="{Binding Android.PackageManagement.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="220" AutomationProperties.Name="Search Android packages"
                                         Margin="{StaticResource Thickness.1}" />
                                <ComboBox ItemsSource="{Binding Android.PackageManagement.ListFilters}"
                                          SelectedItem="{Binding Android.PackageManagement.SelectedList, Mode=TwoWay}"
                                          Width="120" AutomationProperties.Name="Android package list filter"
                                          Margin="{StaticResource Thickness.1}" />
                                <ComboBox ItemsSource="{Binding Android.PackageManagement.RemovalFilters}"
                                          SelectedItem="{Binding Android.PackageManagement.SelectedRemoval, Mode=TwoWay}"
                                          Width="120" AutomationProperties.Name="Android removal tier filter"
                                          Margin="{StaticResource Thickness.1}" />
                                <ComboBox ItemsSource="{Binding Android.PackageManagement.StateFilters}"
                                          SelectedItem="{Binding Android.PackageManagement.SelectedState, Mode=TwoWay}"
                                          Width="120" AutomationProperties.Name="Android package state filter"
                                          Margin="{StaticResource Thickness.1}" />
                                <CheckBox Content="Selected only"
                                          IsChecked="{Binding Android.PackageManagement.SelectedOnly, Mode=TwoWay}"
                                          AutomationProperties.Name="Show selected Android packages only"
                                          Margin="{StaticResource Thickness.1}" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.1}">
                                <Button Content="Select all visible" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Android.PackageManagement.SelectAllCommand}"
                                        AutomationProperties.Name="Select all visible Android packages" />
                                <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Android.PackageManagement.ClearCommand}"
                                        AutomationProperties.Name="Clear Android package selection"
                                        Margin="{StaticResource Thickness.1}" />
                                <Button Content="Invert" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Android.PackageManagement.InvertCommand}"
                                        AutomationProperties.Name="Invert visible Android package selection"
                                        Margin="{StaticResource Thickness.1}" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Android.PackageManagement.VisiblePackages}"
                                     SelectedItem="{Binding Android.PackageManagement.FocusedPackage, Mode=TwoWay}"
                                     MaxHeight="360"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True"
                                     Background="Transparent" BorderThickness="0"
                                     AutomationProperties.Name="Android packages">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowCard}" Padding="{StaticResource Thickness.2}"
                                                Margin="{StaticResource Row.Margin}"
                                                AutomationProperties.Name="{Binding AutomationName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding AutomationName}"
                                                          Margin="{StaticResource Thickness.2}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource CaptionText}"
                                                               TextWrapping="Wrap" MaxHeight="42" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding ListText}" FontSize="10" />
                                                    <TextBlock Text="{Binding RemovalText}" FontSize="10" />
                                                    <TextBlock Text="{Binding StateText}" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.3}"
                                    Margin="{StaticResource Thickness.2}">
                                <StackPanel>
                                    <TextBlock Text="Review and apply" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Android.PackageManagement.ReviewText}"
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                    <CheckBox Content="Disable instead of uninstall"
                                              IsChecked="{Binding Android.PackageManagement.DisableInsteadOfUninstall, Mode=TwoWay}"
                                              AutomationProperties.Name="Disable Android packages instead of uninstall" />
                                    <CheckBox Content="Expert mode"
                                              IsChecked="{Binding Android.PackageManagement.ExpertMode, Mode=TwoWay}"
                                              AutomationProperties.Name="Android Expert mode" />
                                    <TextBox Text="{Binding Android.PackageManagement.ExpertConfirmation, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Exact protected package confirmation"
                                             Margin="{StaticResource Thickness.1}" />
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.1}">
                                        <Button Content="Review package batch" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding Android.PackageManagement.ReviewCommand}"
                                                AutomationProperties.Name="Review Android package batch" />
                                        <Button Content="Apply batch" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding Android.PackageManagement.ApplyCommand}"
                                                AutomationProperties.Name="Apply Android package batch"
                                                Margin="{StaticResource Thickness.1}" />
                                        <Button Content="Undo last batch" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Android.PackageManagement.UndoCommand}"
                                                AutomationProperties.Name="Undo Android package batch"
                                                Margin="{StaticResource Thickness.1}" />
                                    </StackPanel>
                                    <WrapPanel Margin="{StaticResource Thickness.1}">
                                        <Button Content="Recommended preset" Style="{StaticResource PillButton}"
                                                Command="{Binding Android.PackageManagement.RecommendedPresetCommand}"
                                                AutomationProperties.Name="Apply Android recommended preset"
                                                Margin="{StaticResource Thickness.1}" />
                                        <Button Content="Export .txt" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Android.PackageManagement.ExportTextCommand}"
                                                AutomationProperties.Name="Export Android selection text"
                                                Margin="{StaticResource Thickness.1}" />
                                        <Button Content="Export FPM JSON" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Android.PackageManagement.ExportJsonCommand}"
                                                AutomationProperties.Name="Export Android selection JSON"
                                                Margin="{StaticResource Thickness.1}" />
                                        <Button Content="Import selection" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Android.PackageManagement.ImportSelectionCommand}"
                                                AutomationProperties.Name="Import Android package selection"
                                                Margin="{StaticResource Thickness.1}" />
                                        <Button Content="Open action log" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Android.PackageManagement.OpenLogCommand}"
                                                AutomationProperties.Name="Open Android action log"
                                                Margin="{StaticResource Thickness.1}" />
                                    </WrapPanel>
                                    <Grid Margin="{StaticResource Thickness.1}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Android.PackageManagement.Snapshots}"
                                                  SelectedItem="{Binding Android.PackageManagement.SelectedSnapshot, Mode=TwoWay}"
                                                  DisplayMemberPath="Id"
                                                  AutomationProperties.Name="Android package snapshots"
                                                  Margin="{StaticResource Thickness.1}" />
                                        <Button Grid.Column="1" Content="Create snapshot"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding Android.PackageManagement.CreateSnapshotCommand}"
                                                AutomationProperties.Name="Create Android package snapshot"
                                                Margin="{StaticResource Thickness.1}" />
                                        <Button Grid.Column="2" Content="Restore snapshot"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding Android.PackageManagement.RestoreSnapshotCommand}"
                                                AutomationProperties.Name="Restore Android package snapshot"
                                                Margin="{StaticResource Thickness.1}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Android.PackageManagement.ResultText}"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       AutomationProperties.Name="Android package batch result" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                           Margin="{StaticResource Thickness.1}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
