<UserControl x:Class="PCManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCManager.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,12,14">
        <Grid MaxWidth="{StaticResource App.ContentMaxWidth}" HorizontalAlignment="Stretch">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon3D Key="Settings" Size="44" Margin="{StaticResource Thickness.3}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="Preferences, automation and where this app keeps its files." />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Start with Windows -->
            <Border Style="{StaticResource Card}" Padding="{StaticResource Card.PaddingExpanded}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon3D Key="Startup" Size="24" Margin="{StaticResource Thickness.1}" />
                            <TextBlock Text="Start with Windows" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="Registers this app under its own Run value so it never touches Microsoft PC Manager's entry." />
                        <TextBlock Text="{Binding RunValueText}" Style="{StaticResource CaptionText}"
                                   FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Content="Start with Windows"
                              VerticalAlignment="Center"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Smart Boost -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="SmartBoost" Size="24" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Smart Boost" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SmartBoostThresholdText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Content="Enabled"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding SmartBoostEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Slider Style="{StaticResource FluentSlider}" Minimum="50" Maximum="95"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding SmartBoostThreshold, Mode=TwoWay}" Margin="0,16,0,0" MaxWidth="520"
                            HorizontalAlignment="Left" Width="520" />
                    <Button Content="Reset to 75%" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding ResetThresholdCommand}" />
                </StackPanel>
            </Border>

            <!-- Whitelist -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Whitelist" Size="24" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Protected paths" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding WhitelistCountText}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <Button Content="Reload" Style="{StaticResource PillButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding ReloadWhitelistCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,8"
                               Text="Paths here are excluded from scans and refused by the safety guard. The hard deny-list still applies. Use the full path." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding WhitelistPathInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="For example C:\Projects or D:\Source\vendor" />
                        <Button Grid.Column="1" Content="Add path" Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" Command="{Binding AddWhitelistCommand}" />
                    </Grid>

                    <ListBox ItemsSource="{Binding WhitelistEntries}"
                             SelectedItem="{Binding SelectedWhitelistEntry, Mode=TwoWay}"
                             Background="{DynamicResource App.Card}"
                             BorderBrush="{DynamicResource App.Border}"
                             Foreground="{DynamicResource App.Text}"
                             MaxHeight="150" Margin="0,8,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Remove selected" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RemoveWhitelistCommand}" />
                        <Button Content="Open whitelist folder" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Command="{Binding OpenWhitelistFolderCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding WhitelistFilePath}" Style="{StaticResource CaptionText}"
                               FontFamily="Consolas" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Quarantine -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon3D Key="Quarantine" Size="24" Margin="{StaticResource Thickness.1}" />
                        <TextBlock Text="Quarantine" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding QuarantinePolicyText}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />

                    <TextBlock Text="Retention" Style="{StaticResource SectionTitle}" Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="3 days" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                Command="{Binding SetQuarantineRetentionCommand}" CommandParameter="3" />
                        <Button Content="7 days" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                Command="{Binding SetQuarantineRetentionCommand}" CommandParameter="7" />
                        <Button Content="30 days" Style="{StaticResource PillButton}"
                                Command="{Binding SetQuarantineRetentionCommand}" CommandParameter="30" />
                    </StackPanel>

                    <TextBlock Text="Maximum size (oldest entries are removed first)" Style="{StaticResource SectionTitle}"
                               Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="1 GB" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                Command="{Binding SetQuarantineMaxSizeCommand}" CommandParameter="1" />
                        <Button Content="2 GB" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                Command="{Binding SetQuarantineMaxSizeCommand}" CommandParameter="2" />
                        <Button Content="5 GB" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                Command="{Binding SetQuarantineMaxSizeCommand}" CommandParameter="5" />
                        <Button Content="10 GB" Style="{StaticResource PillButton}"
                                Command="{Binding SetQuarantineMaxSizeCommand}" CommandParameter="10" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <DockPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="Dark theme"
                                  DockPanel.Dock="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding IsDark, Mode=TwoWay}" />
                        <StackPanel>
                            <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionText}">
                                <Run Text="Current theme: " /><Run Text="{Binding ThemeLabel, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Show splash screen"
                              Margin="{StaticResource Thickness.3}" IsChecked="{Binding ShowSplash, Mode=TwoWay}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Close button keeps FPM in the tray"
                              Margin="{StaticResource Thickness.2}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Reduce motion (fades only)"
                              Margin="{StaticResource Thickness.2}" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Battery (T1): always shown, including the honest "No battery detected" state. -->
            <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.5}">
                <StackPanel>
                    <TextBlock Text="Battery" FontSize="17" FontWeight="SemiBold" />
                    <controls:BatteryTile DataContext="{Binding Battery}"
                                          Margin="{StaticResource Thickness.3}" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                        <Run Text="Time: " /><Run Text="{Binding Battery.TimeText, Mode=OneWay}" />
                        <Run Text=" · Health: " /><Run Text="{Binding Battery.HealthText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Battery.SampledText}" Style="{StaticResource CaptionText}"
                               Margin="{StaticResource Thickness.1}" />
                </StackPanel>
            </Border>

            <!-- Temperature (T2): system thermal zone, with the honest unavailable reason. -->
            <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.5}">
                <StackPanel>
                    <TextBlock Text="Temperature" FontSize="17" FontWeight="SemiBold" />
                    <controls:TemperatureTile DataContext="{Binding Temperature}"
                                              Margin="{StaticResource Thickness.3}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Show Fahrenheit (°F)"
                              Margin="{StaticResource Thickness.2}"
                              IsChecked="{Binding IsFahrenheit, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Temperature.SampledText}" Style="{StaticResource CaptionText}"
                               Margin="{StaticResource Thickness.1}" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Text="ACPI thermal zones need administrator rights on many machines. FPM never labels a zone reading as a CPU temperature." />
                </StackPanel>
            </Border>

            <!-- Virtual desktops (W2) -->
            <Border Style="{StaticResource Card}" Padding="{StaticResource Thickness.5}">
                <StackPanel>
                    <TextBlock Text="Virtual desktops" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Text="Windows has no documented way to pin a window to every desktop, so FPM follows the desktop you switch to. Pop-ups stay on their owner's desktop." />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Toolbar follows me"
                              Margin="{StaticResource Thickness.3}"
                              IsChecked="{Binding ToolbarFollowDesktops, Mode=TwoWay}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="Main window follows me"
                              Margin="{StaticResource Thickness.2}"
                              IsChecked="{Binding MainWindowFollowDesktops, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Padding="20">
                                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon3D Key="Logo" Size="24" Margin="{StaticResource Thickness.1}" />
                            <TextBlock Text="About" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.AccentBar}" Margin="{StaticResource Thickness.2}" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" />

                    <TextBlock Text="Settings and logs" Style="{StaticResource SectionTitle}"
                               Margin="{StaticResource Section.HeaderMargin}" />
                    <TextBlock Text="{Binding DataFolderPath}" Style="{StaticResource CaptionText}" FontFamily="Consolas" />
                    <TextBlock Text="{Binding LogFilePath}" Style="{StaticResource CaptionText}" FontFamily="Consolas"
                               Margin="{StaticResource Thickness.1}" />

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.3}">
                        <Button Content="Open data folder" Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenDataFolderCommand}" />
                        <Button Content="Open logs" Style="{StaticResource SecondaryButton}"
                                Margin="{StaticResource Thickness.2}" Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="{StaticResource Thickness.1}" />

        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
