<Window x:Class="PCManager.Views.FloatingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PCManager.Controls"
        Title="FPM Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid x:Name="Root" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Dock left" Click="DockLeft_Click" />
                <MenuItem Header="Dock top" Click="DockTop_Click" />
                <MenuItem Header="Dock right" Click="DockRight_Click" />
                <MenuItem Header="Dock bottom" Click="DockBottom_Click" />
                <MenuItem Header="Undock" Click="Undock_Click" />
                <Separator />
                <MenuItem Header="Opacity" StaysOpenOnClick="True">
                    <Slider x:Name="OpacitySlider" Minimum="0.6" Maximum="1" SmallChange="0.05"
                            LargeChange="0.1" Width="160" ValueChanged="OpacitySlider_ValueChanged" />
                </MenuItem>
                <MenuItem Header="Opacity 100%" Click="Opacity100_Click" />
                <MenuItem Header="Opacity 90%" Click="Opacity90_Click" />
                <MenuItem Header="Opacity 80%" Click="Opacity80_Click" />
                <MenuItem x:Name="TopmostMenuItem" Header="Always on top" IsCheckable="True" Click="Topmost_Click" />
                <MenuItem Header="Reset position" Click="Reset_Click" />
                <Separator />
                <MenuItem Header="Hide toolbar" Click="Hide_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Undocked / expanded: the familiar pill plus its quick-tools drawer. -->
        <Border x:Name="CompactShell"
                Background="{DynamicResource App.Card}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12,7"
                MouseLeftButtonDown="Root_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
            </Border.Effect>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionButton}" Width="24" Height="24"
                            Command="{Binding OpenFpmCommand}" ToolTip="Open FPM" Margin="0,0,4,0"
                            AutomationProperties.Name="Open FPM">
                        <controls:Icon3D Key="Logo" Size="16" VerticalAlignment="Center"
                                         AutomationProperties.Name="FPM emblem" />
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="{Binding FreeText}">
                        <controls:Icon3D Key="Memory" Size="18" Margin="{StaticResource Thickness.1}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding LoadText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.AccentBar}" />
                            <TextBlock Text="RAM" Style="{StaticResource CaptionText}" FontSize="9" />
                        </StackPanel>
                    </StackPanel>

                    <!-- T1: the shared battery tile; hides itself when Windows reports no battery. -->
                    <controls:BatteryTile IsCompact="True" DataContext="{Binding Battery}"
                                         Margin="{StaticResource Thickness.2}" />
                    <controls:TemperatureTile IsCompact="True" DataContext="{Binding Temperature}"
                                              Margin="{StaticResource Thickness.2}" />

                    <Button Style="{StaticResource PillButton}" Margin="8,0,0,0" Height="24"
                            FontSize="11"
                            Command="{Binding BoostCommand}" ToolTip="Release temporary files"
                            AutomationProperties.Name="Boost">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon3D Key="Boost" Size="12" Tint="Neutral" Margin="{StaticResource Thickness.1}" />
                            <TextBlock Text="Boost" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="22" Background="{DynamicResource App.Border}" Margin="10,0" />

                    <!-- W5: the same Boost host at compact scale, driven by the shared coordinator. -->
                    <controls:BoostAnimationHost IsCompact="True" Margin="{StaticResource Thickness.1}"
                                                 Phase="{Binding BoostPhase}"
                                                 Headline="{Binding BoostHeadline}"
                                                 ResultText="{Binding BoostResultText}"
                                                 FreedBytes="{Binding BoostFreedBytes}"
                                                 CancelCommand="{Binding CancelBoostCommand}"
                                                 AutomationProperties.Name="Toolbar boost progress" />

                    <Border Width="1" Height="22" Background="{DynamicResource App.Border}" Margin="10,0" />

                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" ToolTip="{Binding NetworkTooltip}">
                        <TextBlock Text="{Binding DownloadSpeedText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text}" />
                        <TextBlock Text="{Binding UploadSpeedText}" FontSize="10"
                                   Style="{StaticResource CaptionText}" />
                    </StackPanel>

                    <Border Width="1" Height="22" Background="{DynamicResource App.Border}" Margin="10,0" />

                    <Button Style="{StaticResource CaptionButton}" Width="24" Height="24"
                            Command="{Binding ToggleDrawerCommand}" ToolTip="Quick tools"
                            AutomationProperties.Name="Quick tools">
                        <controls:Icon3D Key="More" Size="14" Tint="Neutral" />
                    </Button>

                    <Button x:Name="PinButton" Style="{StaticResource CaptionButton}" Width="24" Height="24"
                            Click="Pin_Click" ToolTip="Pin expanded"
                            AutomationProperties.Name="Pin expanded">
                        <Path x:Name="PinIcon" Data="{DynamicResource Icon.Pin}" Width="12" Height="12"
                              Stretch="Uniform" Fill="{DynamicResource App.Subtle}" />
                    </Button>

                    <Button Style="{StaticResource CaptionButton}" Width="24" Height="24" Margin="2,0,0,0"
                            Click="Close_Click" ToolTip="Hide toolbar" AutomationProperties.Name="Hide toolbar">
                        <controls:Icon3D Key="Close" Size="12" Tint="Neutral" />
                    </Button>
                </StackPanel>

                <Border Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,8,0,0" Padding="0,6,0,0"
                        BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PillButton}" Margin="{StaticResource Thickness.1}" Height="24"
                                FontSize="11" Command="{Binding ScreenshotCommand}" ToolTip="Take full screenshot">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Screenshot" Size="12" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Shot" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Margin="{StaticResource Thickness.1}" Height="24"
                                FontSize="11" Command="{Binding NotepadCommand}" ToolTip="Open Notepad">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Notepad" Size="12" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Note" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Margin="{StaticResource Thickness.1}" Height="24"
                                FontSize="11" Command="{Binding CalculatorCommand}" ToolTip="Open Calculator">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Calculator" Size="12" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Calc" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Margin="{StaticResource Thickness.1}" Height="24"
                                FontSize="11" Command="{Binding TaskManagerCommand}" ToolTip="Open Task Manager">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="ProcessList" Size="12" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Task" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Height="24"
                                FontSize="11" Command="{Binding OpenFpmCommand}" ToolTip="Open FPM Window">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Logo" Size="12" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Open" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Docked and collapsed: a 32 px tab showing the key metric. -->
        <Border x:Name="DockTab"
                Visibility="Collapsed"
                Background="{DynamicResource App.Card}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Button}"
                MouseLeftButtonUp="DockTab_MouseLeftButtonUp">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls:Icon3D Key="Memory" Size="18" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding LoadText}" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="{StaticResource Thickness.1}"
                           Foreground="{DynamicResource App.AccentBar}" />
                <TextBlock Text="RAM" Style="{StaticResource CaptionText}" FontSize="9"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
