<UserControl x:Class="PCManager.Views.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCManager.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,12,14">
        <Grid MaxWidth="{StaticResource App.ContentMaxWidth}" HorizontalAlignment="Stretch">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <controls:Icon3D Key="Toolbar" Size="44" Margin="{StaticResource Thickness.3}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Toolbox" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="Everyday utilities plus the floating toolbar for quick access from anywhere." />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Floating toolbar -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:Icon3D Key="Toolbar" Size="40" VerticalAlignment="Center" Animated="True" />

                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="Show floating toolbar" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="A small always-on-top pill with live RAM, one-click Boost, screenshot, Notepad and Calculator. Drag it anywhere." />
                    </StackPanel>

                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              IsChecked="{Binding ShowFloatingToolbar, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- T3: persisted toolbox/widget layout -->
            <Border Style="{StaticResource Card}" Padding="{StaticResource Card.Padding}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon3D Key="Toolbox" Size="24" Margin="{StaticResource Thickness.1}" />
                        <TextBlock Text="Widgets &amp; tools" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Choose and reorder the metrics/tools shown by the floating toolbar."
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="{StaticResource Thickness.2}" />

                    <ItemsControl ItemsSource="{Binding LayoutItems}"
                                  AutomationProperties.Name="Toolbox layout">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}"
                                        Padding="{StaticResource Row.Padding}"
                                        Margin="{StaticResource Row.Margin}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  Command="{Binding DataContext.ToggleLayoutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Title}" />
                                        <controls:Icon3D Grid.Column="1" Key="{Binding Icon3DKey}" Size="20"
                                                         Margin="{StaticResource Thickness.2}" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="&#x25B2;" Style="{StaticResource PillButton}"
                                                Command="{Binding DataContext.MoveLayoutUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding Title, StringFormat='Move {0} up'}"
                                                Margin="{StaticResource Thickness.1}" />
                                        <Button Grid.Column="4" Content="&#x25BC;" Style="{StaticResource PillButton}"
                                                Command="{Binding DataContext.MoveLayoutDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}"
                                                AutomationProperties.Name="{Binding Title, StringFormat='Move {0} down'}"
                                                Margin="{StaticResource Thickness.1}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Thickness.2}">
                        <Button Content="Reset layout" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ResetLayoutCommand}" />
                        <Button Content="Export layout" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ExportLayoutCommand}" Margin="{StaticResource Thickness.2}" />
                        <Button Content="Import layout" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ImportLayoutCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Tools" Style="{StaticResource SectionTitle}" Margin="0,6,0,10" />

            <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ActionCard}"
                                Command="{Binding DataContext.LaunchToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Id}">
                            <StackPanel>
                                <controls:Icon3D Key="{Binding Icon3DKey}" Size="32"
                                                 HorizontalAlignment="Left" Animated="True" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,10,0,2" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />

        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
