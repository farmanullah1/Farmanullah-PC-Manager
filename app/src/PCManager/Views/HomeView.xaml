<UserControl x:Class="PCManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PCManager.Controls"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- §8.4/§8.6 Bento shares the app-wide content cap; Stretch + MaxWidth centres the
             column on wider windows. -->
        <Grid x:Name="HomeLayout" MaxWidth="{StaticResource App.ContentMaxWidth}"
              HorizontalAlignment="Stretch" Margin="10,9,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================ A: contextual tip ============================ -->
            <Border x:Name="TipCard" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}" Padding="9,10" Margin="0,0,0,8"
                    Visibility="{Binding IsTipVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{DynamicResource App.AccentSoft}"
                            VerticalAlignment="Center">
                        <Grid>
                            <controls:Icon3D Key="Tips" Size="21"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Animated="True" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource App.AccentLabel}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TipTitle}" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="{Binding TipBody}"
                                   FontSize="10.5" Foreground="{DynamicResource App.Subtle}"
                                   TextWrapping="Wrap" Margin="0,1,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <Button Style="{StaticResource PillButton}" Command="{Binding OpenTipLinkCommand}"
                                    HorizontalAlignment="Left" Padding="0,2,0,0"
                                    ToolTip="Open the page this tip describes">
                                <TextBlock Text="{Binding TipLinkText}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.AccentLabel}" />
                            </Button>

                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Margin="0,0,3,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource App.Subtle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TipIndex}" Value="0">
                                                    <Setter Property="Fill" Value="{DynamicResource App.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Width="5" Height="5" Margin="0,0,3,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource App.Subtle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TipIndex}" Value="1">
                                                    <Setter Property="Fill" Value="{DynamicResource App.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Width="5" Height="5" Margin="0,0,5,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource App.Subtle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TipIndex}" Value="2">
                                                    <Setter Property="Fill" Value="{DynamicResource App.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Button Style="{StaticResource CaptionButton}" Content="&#x2039;"
                                        Width="18" Height="18" FontSize="11"
                                        Command="{Binding PreviousTipCommand}" ToolTip="Previous tip"
                                        AutomationProperties.Name="Previous tip" />
                                <Button Style="{StaticResource CaptionButton}" Content="&#x203A;"
                                        Width="18" Height="18" FontSize="11"
                                        Command="{Binding NextTipCommand}" ToolTip="Next tip"
                                        AutomationProperties.Name="Next tip" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource CaptionButton}"
                            Width="18" Height="18" VerticalAlignment="Top"
                            Command="{Binding DismissTipCommand}" ToolTip="Dismiss tip">
                        <TextBlock Text="&#x2715;" FontSize="8" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============================ B: PC boost hero ============================ -->
            <Border x:Name="BoostCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}" Padding="11,12" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:Icon3D Key="Boost" Size="19" VerticalAlignment="Center" Animated="True" />
                            <TextBlock Text="PC boost" FontSize="12.5" FontWeight="Bold"
                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                  Content="Smart boost"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding SmartBoostEnabled, Mode=TwoWay}"
                                  ToolTip="Trim memory automatically when usage crosses the threshold" />
                    </Grid>

                    <TextBlock Text="{Binding BoostStatusText}"
                               FontSize="10.5" Foreground="{DynamicResource App.Subtle}"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                    <controls:BoostAnimationHost Margin="{StaticResource Thickness.2}"
                                                 Phase="{Binding BoostPhase}"
                                                 Headline="{Binding BoostHeadline}"
                                                 ResultText="{Binding BoostResultText}"
                                                 FreedBytes="{Binding BoostFreedBytes}"
                                                 CancelCommand="{Binding CancelBoostCommand}"
                                                 AutomationProperties.Name="Boost progress" />

                    <!-- T1: the same shared battery reading as the toolbar and Settings. -->
                    <controls:BatteryTile DataContext="{Binding Battery}"
                                          Margin="{StaticResource Thickness.2}" />

                    <!-- T2: system thermal zone (never labelled as a CPU sensor). -->
                    <controls:TemperatureTile DataContext="{Binding Temperature}"
                                              Margin="{StaticResource Thickness.2}" />

                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" CornerRadius="1.5"
                                    Background="{DynamicResource App.Accent}"
                                    Margin="0,2,0,9" />
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="{Binding LoadText}" FontSize="19" FontWeight="Bold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI" />
                                <TextBlock Text="Memory usage" FontSize="9.5"
                                           Foreground="{DynamicResource App.Subtle}" />
                                <ProgressBar Style="{StaticResource ThinProgress}" Height="3"
                                             Margin="0,4,0,0" Value="{Binding LoadPercent}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="3" CornerRadius="1.5"
                                    Background="{DynamicResource App.Accent}"
                                    Margin="0,2,0,9" />
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="{Binding TempFilesText}" FontSize="19" FontWeight="Bold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Temporary files" FontSize="9.5"
                                           Foreground="{DynamicResource App.Subtle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="30"
                                HorizontalAlignment="Stretch"
                                Command="{Binding BoostCommand}"
                                AutomationProperties.Name="Boost"
                                ToolTip="Trim process working sets and delete temporary files">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:Icon3D Key="Boost" Size="14" Tint="Neutral" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BoostButtonText}" FontSize="12" FontWeight="Bold"
                                           Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="30"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CleanEverythingCommand}"
                                ToolTip="Run unified scan across all supported categories">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:Icon3D Key="Scan" Size="14" VerticalAlignment="Center" />
                                <TextBlock Text="Clean Everything" FontSize="11" FontWeight="SemiBold"
                                           Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding ResultText}" FontSize="9"
                               Foreground="{DynamicResource App.Subtle}"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ResultText}" />
                </StackPanel>
            </Border>

            <!-- ============================ C: 2x2 quick actions ============================ -->
            <Grid x:Name="UtilityGrid" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Health check -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ActionCard}"
                        Margin="0,0,4,4" MinHeight="76" Command="{Binding OpenProtectionCommand}"
                        ToolTip="Open Protection: Defender, updates and firewall">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Health check" FontSize="11.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <controls:Icon3D Key="HealthCheck" Size="20" Animated="True" />
                                <TextBlock Text="&#x203A;" FontSize="12" Margin="3,0,0,0"
                                           Foreground="{DynamicResource App.Subtle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <TextBlock Text="Protection &amp; updates" FontSize="9"
                                       Foreground="{DynamicResource App.Subtle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Check status" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.AccentLabel}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Process -->
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ActionCard}"
                        Margin="4,0,0,4" MinHeight="76" Command="{Binding OpenProcessesCommand}"
                        ToolTip="Open Apps: running processes and End Task">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Process" FontSize="11.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <controls:Icon3D Key="Process" Size="20" Animated="True" />
                                <TextBlock Text="&#x203A;" FontSize="12" Margin="3,0,0,0"
                                           Foreground="{DynamicResource App.Subtle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <TextBlock Text="Running now" FontSize="9"
                                       Foreground="{DynamicResource App.Subtle}" />
                            <TextBlock Text="{Binding ProcessCountText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.AccentLabel}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Deep cleanup -->
                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ActionCard}"
                        Margin="0,4,4,0" MinHeight="76" Command="{Binding OpenCleanupCommand}"
                        ToolTip="Open Storage: Cleanup Center and duplicate files">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Deep cleanup" FontSize="11.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <controls:Icon3D Key="DeepCleanup" Size="20" Animated="True" />
                                <TextBlock Text="&#x203A;" FontSize="12" Margin="3,0,0,0"
                                           Foreground="{DynamicResource App.Subtle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <TextBlock Text="Local Disk (C:)" FontSize="9"
                                       Foreground="{DynamicResource App.Subtle}" />
                            <TextBlock Text="{Binding DiskUsageText}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.AccentLabel}" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar Style="{StaticResource ThinProgress}" Height="2.5"
                                         Margin="0,3,0,0" Value="{Binding DiskUsedPercent}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Startup -->
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ActionCard}"
                        Margin="4,4,0,0" MinHeight="76" Command="{Binding OpenStartupCommand}"
                        ToolTip="Open Apps: startup programs">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Startup" FontSize="11.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <controls:Icon3D Key="Startup" Size="20" Animated="True" />
                                <TextBlock Text="&#x203A;" FontSize="12" Margin="3,0,0,0"
                                           Foreground="{DynamicResource App.Subtle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="Manage startup apps in system settings"
                                   FontSize="9" Foreground="{DynamicResource App.Subtle}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </Grid>
                </Button>
            </Grid>

            <!-- ==================== D: one-click cleanup + status chips ==================== -->
            <Border x:Name="CleanupCard" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}" Padding="11,12" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="7"
                                    Background="{DynamicResource App.AccentSoft}" VerticalAlignment="Center">
                                <controls:Icon3D Key="OneClickCleanup" Size="22"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Animated="True" />
                            </Border>
                            <StackPanel Margin="9,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="One-Click Cleanup" FontSize="12.5" FontWeight="Bold" />
                                <TextBlock Text="Scan, review and clean supported junk"
                                           FontSize="9.5" Foreground="{DynamicResource App.Subtle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButton}" Height="28"
                                VerticalAlignment="Center"
                                Command="{Binding CleanEverythingCommand}"
                                ToolTip="Open the Cleanup Center to scan and review every supported category">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Scan" Size="14" Tint="Neutral" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Scan &amp; review" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <Button Style="{StaticResource PillButton}" Command="{Binding OpenMemoryCommand}"
                                ToolTip="Open the Memory page">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Memory" Size="14" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="{Binding MemoryChipText}" FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Margin="6,0,0,0"
                                Command="{Binding OpenStorageCommand}"
                                ToolTip="Open the Storage page">
                            <TextBlock Text="{Binding StorageChipText}" FontSize="10" FontWeight="SemiBold" />
                        </Button>
                        <TextBlock Text="Nothing is removed without review."
                                   FontSize="9" Foreground="{DynamicResource App.Subtle}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================ D: compact capture strip ============================ -->
            <Border x:Name="CaptureCard" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}" Padding="9,10" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="30" Height="30" CornerRadius="6"
                                Background="{DynamicResource App.AccentSoft}" VerticalAlignment="Center">
                            <controls:Icon3D Key="Screenshot" Size="20" Tint="Neutral"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="9,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="Quick capture" FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="Screenshot every monitor to Pictures"
                                       FontSize="9.5" Foreground="{DynamicResource App.Subtle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                                            <Button Grid.Column="1" Style="{StaticResource OutlineGoldButton}"
                                Command="{Binding CaptureCommand}"
                                VerticalAlignment="Center"
                                ToolTip="{Binding StatusMessage}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon3D Key="Screenshot" Size="14" Margin="{StaticResource Thickness.1}" />
                                <TextBlock Text="Capture" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                </Grid>
            </Border>

            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{Binding StatusMessage}" FontSize="9"
                       Foreground="{DynamicResource App.Subtle}"
                       Margin="2,5,2,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusMessage}" />
        </Grid>
    </ScrollViewer>
</UserControl>
