<UserControl x:Class="PCManager.Controls.BoostAnimationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Host"
             Focusable="False">

    <Grid MinHeight="44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Canvas x:Name="Stage" Width="40" Height="42" VerticalAlignment="Center">
            <Path x:Name="Rocket"
                  Data="M20,2 L27,16 L23,16 L23,28 L17,28 L17,16 L13,16 Z"
                  Fill="{DynamicResource App.AccentBar}"
                  RenderTransformOrigin="0.5,0.8" />
            <Path x:Name="Flame"
                  Data="M16,29 L20,39 L24,29 Z"
                  Fill="{DynamicResource App.Accent}"
                  RenderTransformOrigin="0.5,0"
                  Visibility="Collapsed" />
        </Canvas>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="{StaticResource Thickness.2}">
            <TextBlock x:Name="HeadlineText" FontSize="10.5"
                       Foreground="{DynamicResource App.Subtle}"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Style="{StaticResource PillButton}"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource Thickness.1}"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Cancel Boost" />
            <Border x:Name="Chip"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource Thickness.1}"
                    Padding="{StaticResource Thickness.1}"
                    CornerRadius="{StaticResource Radius.Button}"
                    Background="{DynamicResource App.AccentSoft}"
                    BorderBrush="{DynamicResource App.AccentBorder}"
                    BorderThickness="1">
                <TextBlock x:Name="ChipText" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.AccentLabel}" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
